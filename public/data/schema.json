{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visacode.github.io/daily-dose/data/schema.json",
  "title": "Daily Dose edition",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "updated", "items"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Edition date, Asia/Riyadh calendar day."
    },
    "updated": {
      "type": "string",
      "minLength": 1,
      "description": "Human label shown in the hero, e.g. Tue 10 Nov 2026."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["cat", "title", "note", "source", "href", "tag"],
      "properties": {
        "cat": {
          "enum": ["memes", "places", "things", "gemPlaces", "gemApps"]
        },
        "title": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1, "description": "Short card blurb." },
        "source": { "type": "string", "minLength": 1, "description": "Outlet name shown on the card." },
        "href": { "type": "string", "format": "uri", "description": "Canonical URL. Open original goes here." },
        "tag": { "type": "string", "minLength": 1 },
        "read": { "type": "string", "description": "Reader body. Falls back to note when omitted." },
        "facts": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "string" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "image": { "type": "string", "description": "Photo or og:image URL. Shown on the card and in the reader." },
        "video": { "type": "string", "description": "Direct video file URL (mp4, webm). YouTube URLs should use href + embed instead." },
        "embed": {
          "enum": ["youtube", "x", "tiktok", "instagram", "image", "map", "none"],
          "description": "Optional. When omitted, Daily Dose infers it from href and cat."
        },
        "mapQuery": {
          "type": "string",
          "description": "Optional Google Maps search text. Used when embed is map, or for places and gemPlaces."
        },
        "favicon": { "type": "string", "description": "Optional site icon URL." },
        "videoStyle": {
          "enum": ["short", "wide"],
          "description": "Optional. short uses a vertical player. Inferred from Shorts, TikTok, and sub-75-second clips when omitted."
        },
        "article": {
          "type": "object",
          "description": "Optional full-text page. The enrich action fills this when the fields are empty. Bot-written values are kept.",
          "properties": {
            "html": { "type": "string" },
            "paragraphs": { "type": "array", "items": { "type": "string" } },
            "byline": { "type": "string" },
            "published": { "type": "string" },
            "siteName": { "type": "string" }
          }
        },
        "place": {
          "type": "object",
          "description": "Optional place details. Facts such as Hours, Phone, and Address are used when these are omitted.",
          "properties": {
            "hours": { "type": "string" },
            "price": { "type": "string" },
            "area": { "type": "string" },
            "phone": { "type": "string" },
            "rating": { "type": "string" },
            "photos": { "type": "array", "items": { "type": "string" } }
          }
        },
        "app": {
          "type": "object",
          "description": "Optional app details. Platform and price facts are used when these are omitted.",
          "properties": {
            "icon": { "type": "string" },
            "screenshots": { "type": "array", "items": { "type": "string" } },
            "rating": { "type": "string" },
            "price": { "type": "string" },
            "platforms": { "type": "array", "items": { "type": "string" } },
            "appStore": { "type": "string" },
            "playStore": { "type": "string" }
          }
        }
      }
    }
  }
}
