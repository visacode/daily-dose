    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
